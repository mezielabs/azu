{
  "name": "@mezielabs/azu-react",
  "description": "Inertia + React pages and components for Azu",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "author": "Mezie Labs",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "build",
    "src",
    "!build/tests"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./styles.css": "./build/azu.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "compile": "tsc -p tsconfig.build.json && tailwindcss -i ./src/styles.css -o ./build/azu.css --minify",
    "build": "pnpm run compile",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@inertiajs/react": "^3.9.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@inertiajs/react": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "prettier": "@adonisjs/prettier-config"
}
