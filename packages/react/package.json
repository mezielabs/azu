{
  "name": "@mezielabs/azu-react",
  "description": "Inertia + React pages and components for Azu",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "author": "Mezie Labs",
  "engines": {
    "node": ">=24.21.0"
  },
  "files": [
    "build",
    "src",
    "!build/tests"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./styles.css": "./build/azu.css",
    "./rich-text": {
      "types": "./build/features/rich_text_editor.d.ts",
      "default": "./build/features/rich_text_editor.js"
    },
    "./rich-text-fallback": {
      "types": "./build/features/rich_text_fallback.d.ts",
      "default": "./build/features/rich_text_fallback.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "compile": "tsc -p tsconfig.build.json && tailwindcss -i ./src/styles.css -o ./build/azu.css --minify",
    "build": "pnpm run compile",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@inertiajs/react": "^3.9.1",
    "@mezielabs/azu": "workspace:^",
    "@tailwindcss/cli": "^4.3.3",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@inertiajs/react": "^3.0.0",
    "@mezielabs/azu": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "prettier": "@adonisjs/prettier-config",
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "react-aria-components": "^1.22.1"
  },
  "peerDependenciesMeta": {
    "@tiptap/react": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    }
  },
  "azu": {
    "optionalFeatures": [
      {
        "name": "rich text editor",
        "specifier": "@mezielabs/azu-react/rich-text",
        "fallback": "@mezielabs/azu-react/rich-text-fallback",
        "requires": [
          "@tiptap/react",
          "@tiptap/pm",
          "@tiptap/starter-kit"
        ],
        "optimizeDeps": [
          "@tiptap/react",
          "@tiptap/starter-kit"
        ]
      }
    ]
  }
}
