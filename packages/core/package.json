{
  "name": "@mezielabs/azu",
  "description": "Admin panel for AdonisJS 7, built on your Lucid models, Bouncer policies and VineJS validators",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "author": "Mezie Labs",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "build",
    "!build/bin",
    "!build/tests"
  ],
  "main": "build/index.js",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./azu_provider": {
      "types": "./build/providers/azu_provider.d.ts",
      "default": "./build/providers/azu_provider.js"
    },
    "./vite": {
      "types": "./build/vite.d.ts",
      "default": "./build/vite.js"
    },
    "./types": {
      "types": "./build/src/types.d.ts",
      "default": "./build/src/types.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "copy:templates": "copyfiles \"stubs/**/*.stub\" \"resources/**/*.edge\" build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "quick:test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "test": "c8 pnpm run quick:test",
    "compile": "tsdown && tsc --emitDeclarationOnly --declaration",
    "postcompile": "pnpm run copy:templates",
    "build": "pnpm run compile",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.5.2",
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/bouncer": "^4.0.1",
    "@adonisjs/core": "^7.6.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/inertia": "^5.0.1",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@adonisjs/vite": "^6.0.3",
    "@japa/assert": "^4.2.0",
    "@japa/file-system": "^3.0.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/luxon": "^3.7.5",
    "@types/node": "~26.6.2",
    "@vinejs/vine": "^4.4.0",
    "better-sqlite3": "^13.0.3",
    "c8": "^12.0.0",
    "copyfiles": "^2.4.1",
    "edge.js": "^6.5.1",
    "eslint": "^10.11.0",
    "luxon": "^3.7.2",
    "prettier": "^3.9.9",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "@adonisjs/auth": "^10.0.0",
    "@adonisjs/bouncer": "^4.0.0",
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/inertia": "^5.0.0",
    "@adonisjs/lucid": "^22.0.0",
    "@adonisjs/vite": "^6.0.0",
    "@vinejs/vine": "^4.0.0",
    "edge.js": "^6.0.0",
    "vite": "^8.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "tsdown": {
    "entry": [
      "./index.ts",
      "./configure.ts",
      "./vite.ts",
      "./providers/azu_provider.ts",
      "./src/types.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "minify": "dce-only",
    "fixedExtension": false,
    "dts": false,
    "treeshake": false,
    "sourcemaps": false,
    "target": "esnext",
    "unbundle": true
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  },
  "prettier": "@adonisjs/prettier-config",
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
