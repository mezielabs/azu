---
/**
 * The Azu lockup (mark and wordmark), one file per theme. Replaces
 * Starlight's SiteTitle rather than using its `logo` config: with
 * `replacesTitle`, Starlight keeps a screen-reader copy of the title beside
 * the logo's alt text, so the link would read "Azu Azu". Here only the
 * visible image is in the accessibility tree.
 */
import { Image } from 'astro:assets'
import lockup from '../assets/brand/azu-lockup.svg'
import lockupReversed from '../assets/brand/azu-lockup-reversed.svg'

const { siteTitleHref } = Astro.locals.starlightRoute
---

<a href={siteTitleHref} class="site-title">
  <Image src={lockup} alt="Azu" class="dark:sl-hidden" loading="eager" />
  <Image src={lockupReversed} alt="Azu" class="light:sl-hidden" loading="eager" />
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    text-decoration: none;
  }

  .site-title :global(img) {
    height: 2rem;
    width: auto;
  }

  @media (min-width: 50rem) {
    .site-title :global(img) {
      height: 2.125rem;
    }
  }
</style>
