---
/**
 * The Azu wordmark (brand v0.2), one file per theme. Replaces Starlight's
 * SiteTitle rather than using its `logo` config: with `replacesTitle`,
 * Starlight keeps a screen-reader copy of the title beside the logo's
 * alt text, so the link would read "Azu Azu". Here only the visible
 * image is in the accessibility tree.
 */
import { Image } from 'astro:assets'
import wordmark from '../assets/brand/azu-wordmark.svg'
import wordmarkDark from '../assets/brand/azu-wordmark-dark.svg'

const { siteTitleHref } = Astro.locals.starlightRoute
---

<a href={siteTitleHref} class="site-title">
  <Image src={wordmark} alt="Azu" class="dark:sl-hidden" loading="eager" />
  <Image src={wordmarkDark} alt="Azu" class="light:sl-hidden" loading="eager" />
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .site-title :global(img) {
    height: 1.75rem;
    width: auto;
  }
</style>
