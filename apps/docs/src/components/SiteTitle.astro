---
/**
 * The "azu" text wordmark, until the logo is chosen. Replaces
 * Starlight's SiteTitle; the site's name stays "Azu" for page titles.
 */
const { siteTitleHref } = Astro.locals.starlightRoute
---

<a href={siteTitleHref} class="wordmark" aria-label="Azu home">
  <span aria-hidden="true">azu</span>
</a>

<style>
  .wordmark {
    display: flex;
    align-items: center;
    color: var(--sl-color-white);
    font-family: var(--__sl-font);
    font-size: 1.625rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }
</style>
