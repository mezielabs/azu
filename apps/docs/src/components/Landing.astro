---
/** The landing page owns its layout inside Starlight's splash template. */
import { Image } from 'astro:assets'
import { Code, Icon } from '@astrojs/starlight/components'
import { ArrowDown, ArrowRight, Check, Database, ShieldCheck, ListChecks } from '@lucide/astro'
import DemoCode from './DemoCode.astro'
import LandingShot from './LandingShot.astro'
import lockup from '../assets/brand/azu-lockup.svg'
import lockupReversed from '../assets/brand/azu-lockup-reversed.svg'
import listLight from '../../../../docs/screenshots/list-light.png'
import listDark from '../../../../docs/screenshots/list-dark.png'
import listPhoneLight from '../../../../docs/screenshots/list-phone-light.png'
import listPhoneDark from '../../../../docs/screenshots/list-phone-dark.png'
import formLight from '../../../../docs/screenshots/form-light.png'
import formDark from '../../../../docs/screenshots/form-dark.png'
import formPhoneLight from '../../../../docs/screenshots/form-phone-light.png'
import formPhoneDark from '../../../../docs/screenshots/form-phone-dark.png'
import actionsLight from '../../../../docs/screenshots/actions-light.png'
import actionsDark from '../../../../docs/screenshots/actions-dark.png'
import actionsPhoneLight from '../../../../docs/screenshots/actions-phone-light.png'
import actionsPhoneDark from '../../../../docs/screenshots/actions-phone-dark.png'
import overviewLight from '../../../../docs/screenshots/overview-light.png'
import overviewDark from '../../../../docs/screenshots/overview-dark.png'
import overviewPhoneLight from '../../../../docs/screenshots/overview-phone-light.png'
import overviewPhoneDark from '../../../../docs/screenshots/overview-phone-dark.png'
import formCardLight from '../../../../docs/screenshots/form-card-light.png'
import formCardDark from '../../../../docs/screenshots/form-card-dark.png'

const github = 'https://github.com/mezielabs/azu'
const resource = 'app/admin/resources/product_resource.ts'
const previews = [
  {
    id: 'lists',
    label: 'Lists',
    region: 'columns',
    title: 'Your products, ready to manage.',
    description:
      'Search, sort, and filter your records. The URL keeps the view, and rows become cards on phones.',
    note: 'These columns come from the demo store’s product resource. Related records are preloaded.',
    link: '/docs/guides/columns-and-lists/',
    linkLabel: 'Explore lists and columns',
    light: listLight,
    dark: listDark,
    phoneLight: listPhoneLight,
    phoneDark: listPhoneDark,
    alt: 'The Azu Store product list, with search, filters, prices, status badges, and stock levels',
    phoneAlt: 'The Azu Store product list on a phone, with products displayed as cards',
  },
  {
    id: 'forms',
    label: 'Forms',
    region: 'fields',
    title: 'From fields to a product form.',
    description:
      'Group fields into sections, pick related records, and upload images to your configured Drive disk.',
    note: 'The same product resource defines this form. Your VineJS validators check every save.',
    link: '/docs/guides/forms/',
    linkLabel: 'Explore forms and fields',
    light: formLight,
    dark: formDark,
    phoneLight: formPhoneLight,
    phoneDark: formPhoneDark,
    alt: 'The Azu Store product edit form, with details, pricing, relationship pickers, and media fields',
    phoneAlt:
      'The Azu Store product edit form on a phone, with name, SKU, price, and category fields',
  },
  {
    id: 'actions',
    label: 'Actions',
    region: 'publish-action',
    title: 'Publish a whole selection.',
    description:
      'Add actions for one record or many. Azu asks for confirmation and checks the policy for each record.',
    note: 'This is the product resource’s Publish action. Its handler receives the selected records and a transaction.',
    link: '/docs/guides/actions/',
    linkLabel: 'Explore row and bulk actions',
    light: actionsLight,
    dark: actionsDark,
    phoneLight: actionsPhoneLight,
    phoneDark: actionsPhoneDark,
    alt: 'The Azu Store product list with a confirmation dialog for publishing selected products',
    phoneAlt: 'The Azu Store Publish confirmation dialog on a phone',
  },
]
const rules = [
  { icon: Database, title: 'Lucid models', detail: 'Your records and relationships.' },
  {
    icon: ShieldCheck,
    title: 'Bouncer policies',
    detail: 'Your permissions, checked on the server.',
  },
  { icon: ListChecks, title: 'VineJS validators', detail: 'Your validation, shown on each field.' },
]
const terminal = `node ace add @adonisjs/bouncer
npm i @mezielabs/azu@preview @mezielabs/azu-react@preview
node ace configure @mezielabs/azu

# Allow your account in app/abilities/main.ts, then:
node ace migration:run
node ace azu:resource User --policy
npm run dev`
const requirements = [
  'AdonisJS 7 with Lucid, Auth, and Bouncer',
  'Inertia with React',
  'Node.js 24.21 or later',
  'PostgreSQL, MySQL, or SQLite',
]
const footerLinks = [
  { label: 'Docs', href: '/docs/' },
  { label: 'Changelog', href: '/docs/changelog/' },
  { label: 'Roadmap', href: '/docs/roadmap/' },
  { label: 'Discussions', href: `${github}/discussions` },
  { label: 'GitHub', href: github },
]
---

<div class="landing not-content">
  <section class="wrap hero" aria-labelledby="_top">
    <p class="eyebrow caption-1">The AdonisJS admin panel</p>
    <h1 id="_top" class="heading-1">The back of your<br />AdonisJS app.</h1>
    <p class="hero-lead body-lead">
      Build your admin with the Lucid models, Bouncer policies, and VineJS validators you already have.
    </p>
    <div class="hero-actions">
      <a class="btn primary button-md" href="/docs/installation/">Get started <ArrowRight size={18} aria-hidden="true" /></a>
      <a class="btn secondary button-md" href="https://demo.azuadmin.com">Try the demo</a>
      <a class="text-link button-md" href="#product-preview">See how it works <ArrowDown size={16} aria-hidden="true" /></a>
    </div>
  </section>

  <section class="wrap showcase" id="product-preview" aria-labelledby="preview-title" data-preview>
    <div class="showcase-top">
      <div>
        <p class="eyebrow caption-1">One product resource</p>
        <h2 id="preview-title" class="heading-5">What you write. What you get.</h2>
      </div>
      {/* Without JavaScript, every example stays readable and the tabs stay hidden. */}
      <div class="preview-tabs" role="tablist" aria-label="Product resource examples" hidden>
        {previews.map(({ id, label }, index) => (
          <button type="button" class="preview-tab button-sm" id={`tab-${id}`} role="tab"
            aria-controls={`panel-${id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}>{label}</button>
        ))}
      </div>
    </div>
    {previews.map((preview, index) => (
      <div class="preview-panel" id={`panel-${preview.id}`} data-preview-panel>
        <div class="preview-summary">
          <div><h3 class="title-2">{preview.title}</h3><p class="body-3">{preview.description}</p></div>
          <a class="text-link button-sm" href={preview.link}>{preview.linkLabel}<ArrowRight size={16} aria-hidden="true" /></a>
        </div>
        <div class="preview-layout">
          <figure class="preview-visual">
            <LandingShot light={preview.light} dark={preview.dark} phoneLight={preview.phoneLight}
              phoneDark={preview.phoneDark} alt={preview.alt} phoneAlt={preview.phoneAlt} primary={index === 0}
              crop={preview.id === 'actions' ? 'center' : 'top'} />
            <figcaption class="caption-2">Azu Store / Products / {preview.label}</figcaption>
          </figure>
          <details class="preview-code" open data-resource-code>
            <summary class="button-sm"><span class="code-closed">View resource code</span><span class="code-open">Hide resource code</span></summary>
            <div class="code-content">
            <p class="code-label caption-1">product_resource.ts <span>/{preview.region === 'publish-action' ? 'actions' : preview.region}</span></p>
            <DemoCode file={resource} region={preview.region} title={`Product resource · ${preview.label.toLowerCase()}`} />
            <p class="code-note caption-2">{preview.note}</p>
            </div>
          </details>
        </div>
      </div>
    ))}
  </section>

  <section class="rules-band" aria-labelledby="rules-title">
    <div class="wrap rules-section">
      <div class="rules-heading">
        <p class="eyebrow caption-1">Built on your AdonisJS app</p>
        <h2 id="rules-title" class="heading-2">Your app sets the rules.<br />Azu puts them to work.</h2>
        <p class="body-lead muted">Keep permissions and validation in the code your app already runs.</p>
      </div>
      <ul class="rule-sources" role="list">
        {rules.map(({ icon: RuleIcon, title, detail }) => (
          <li>
            <span class="rule-icon"><RuleIcon size={24} stroke-width={1.75} aria-hidden="true" /></span>
            <div><h3 class="title-2">{title}</h3><p class="body-3 muted">{detail}</p></div>
          </li>
        ))}
      </ul>
      <a class="text-link button-sm" href="/docs/guides/resources/">See how a resource fits together <ArrowRight size={16} aria-hidden="true" /></a>
    </div>
  </section>

  <section class="wrap section feature-section" aria-labelledby="screens-title">
    <div class="feature-copy">
      <p class="eyebrow caption-1">Beyond CRUD</p>
      <h2 id="screens-title" class="heading-2">Give your back office<br />a home.</h2>
      <p class="body-lead muted">Add dashboards, reports, and settings pages alongside your resources.</p>
      <p class="body-3 muted">The demo store’s overview brings revenue trends, order totals, and low stock into one screen. Each widget checks access.</p>
      <a class="text-link button-md" href="/docs/guides/widgets/">Build with screens and widgets <ArrowRight size={18} aria-hidden="true" /></a>
    </div>
    <figure class="feature-shot">
      <LandingShot light={overviewLight} dark={overviewDark} phoneLight={overviewPhoneLight} phoneDark={overviewPhoneDark}
        alt="The Azu Store overview, with revenue metrics, a revenue trend, order status, and recent orders"
        phoneAlt="The Azu Store overview on a phone, with revenue and order metrics above the revenue trend" />
      <figcaption class="caption-2 muted">The demo store’s overview, built with Azu’s screen and metric APIs.</figcaption>
    </figure>
  </section>

  <section class="wrap section custom-section" id="customise" aria-labelledby="custom-title">
    <div class="feature-copy">
      <p class="eyebrow caption-1">Make it yours</p>
      <h2 id="custom-title" class="heading-2">Your fields.<br />Your React code.</h2>
      <p class="body-lead muted">Set your brand colour. Bring your own React components when a field needs something specific.</p>
      <p class="body-3 muted">The demo’s SKU input uppercases product codes. It plugs into the same product resource you saw above.</p>
      <a class="text-link button-md" href="/docs/guides/customising/">Customise a field or own a page <ArrowRight size={18} aria-hidden="true" /></a>
      <p class="caption-2 muted">Light and dark themes are built in. Publish a page to edit its React source in your app.</p>
    </div>
    <div class="custom-demo">
      <div class="sku-example">
        <p class="caption-1">Automatic SKU formatting</p>
        <dl>
          <div><dt class="caption-2 muted">You type</dt><dd><code>sku-0007</code></dd></div>
          <div><dt class="caption-2 muted">The field shows</dt><dd><code>SKU-0007</code></dd></div>
        </dl>
      </div>
      <figure class="custom-form">
        <div class="custom-form-crop">
          <Image src={formCardLight} alt="The demo’s product form with the custom SKU input, name, and price fields" class="dark:sl-hidden" loading="lazy" widths={[480, 960]} sizes="(min-width: 64rem) 36rem, calc(100vw - 3rem)" />
          <Image src={formCardDark} alt="The demo’s product form with the custom SKU input, name, and price fields" class="light:sl-hidden" loading="lazy" widths={[480, 960]} sizes="(min-width: 64rem) 36rem, calc(100vw - 3rem)" />
        </div>
        <figcaption class="caption-2 muted">Your component, inside an Azu form.</figcaption>
      </figure>
      <DemoCode file={resource} region="sku-field" title="product_resource.ts · custom SKU field" />
      <a class="text-link button-sm" href="/docs/guides/theming/">Set your brand colour <ArrowRight size={16} aria-hidden="true" /></a>
    </div>
  </section>

  <section class="setup-band" aria-labelledby="install-title">
    <div class="wrap setup-layout">
      <div class="setup-copy">
        <p class="eyebrow caption-1">Start building</p>
        <h2 id="install-title" class="heading-2">Your first resource<br />starts here.</h2>
        <ol class="steps" role="list">
          <li><span class="step-number caption-1">1</span><div><h3 class="title-3">Install and configure</h3><p class="body-3 muted">Add Bouncer, install Azu, and run configure.</p></div></li>
          <li><span class="step-number caption-1">2</span><div><h3 class="title-3">Allow your account</h3><p class="body-3 muted">Update <code>accessAdmin</code> in <code>app/abilities/main.ts</code>.</p></div></li>
          <li><span class="step-number caption-1">3</span><div><h3 class="title-3">Generate a resource</h3><p class="body-3 muted">Point it at a model, sign in, and open <code>/admin</code>.</p></div></li>
        </ol>
        <a class="text-link button-md" href="/docs/installation/">Read the installation guide <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
      <div class="setup-code">
        <Code code={terminal} lang="sh" title="Terminal" />
        <div class="requirements">
          <h3 class="title-3">What you need</h3>
          <ul role="list">{requirements.map((text) => <li class="caption-2"><Check size={16} aria-hidden="true" />{text}</li>)}</ul>
          <a class="text-link button-sm" href="/docs/starter-kits/">Check your starter kit <ArrowRight size={16} aria-hidden="true" /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap closing-wrap" aria-labelledby="closing-title">
    <div class="closing">
      <div class="closing-copy">
        <p class="eyebrow caption-1">Free, open source, and in preview</p>
        <h2 id="closing-title" class="heading-2">Build the back<br />of your app.</h2>
        <p class="body-lead">Azu is MIT licensed. The API may change during preview.</p>
        <a class="limits-link caption-1" href="/docs/preview-limits/">Read the preview limits</a>
      </div>
      <div class="closing-actions">
        <a class="btn on-ink-primary button-md" href="/docs/installation/">Get started <ArrowRight size={18} aria-hidden="true" /></a>
        <div class="community-links">
          <a class="text-link button-sm" href={github}><Icon name="github" size="1rem" />GitHub</a>
          <a class="text-link button-sm" href={`${github}/discussions`}>Join the discussion <ArrowRight size={16} aria-hidden="true" /></a>
        </div>
      </div>
    </div>
  </section>

  <footer class="site-footer">
    <div class="wrap site-footer-inner">
      <div class="site-footer-brand">
        <Image src={lockup} alt="Azu" class="dark:sl-hidden" /><Image src={lockupReversed} alt="Azu" class="light:sl-hidden" />
        <p class="caption-2 muted">Built by <a href="https://mezielabs.com">Mezie Labs</a>. MIT licence.</p>
      </div>
      <nav aria-label="Footer">{footerLinks.map(({ label, href }) => <a class="caption-1" href={href}>{label}</a>)}</nav>
    </div>
  </footer>
</div>

<script>
  const desktopCode = matchMedia('(min-width: 64rem)')
  for (const details of document.querySelectorAll<HTMLDetailsElement>('[data-resource-code]')) {
    const syncCode = () => {
      if (!desktopCode.matches && details.contains(document.activeElement)) {
        details.querySelector('summary')?.focus()
      }
      details.open = desktopCode.matches
    }
    syncCode()
    desktopCode.addEventListener('change', syncCode)
  }
  for (const preview of document.querySelectorAll<HTMLElement>('[data-preview]')) {
    const tablist = preview.querySelector<HTMLElement>('[role="tablist"]')!
    const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')]
    const panels = [...preview.querySelectorAll<HTMLElement>('[data-preview-panel]')]
    const activate = (index: number, focus = false) => {
      tabs.forEach((tab, position) => {
        const selected = position === index
        tab.setAttribute('aria-selected', String(selected))
        tab.tabIndex = selected ? 0 : -1
        panels[position].hidden = !selected
      })
      if (focus) tabs[index].focus()
    }
    panels.forEach((panel, index) => {
      panel.setAttribute('role', 'tabpanel')
      panel.setAttribute('aria-labelledby', tabs[index].id)
      panel.tabIndex = 0
    })
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(index))
      tab.addEventListener('keydown', (event) => {
        let next: number
        switch (event.key) {
          case 'ArrowRight':
            next = (index + 1) % tabs.length
            break
          case 'ArrowLeft':
            next = (index - 1 + tabs.length) % tabs.length
            break
          case 'Home':
            next = 0
            break
          case 'End':
            next = tabs.length - 1
            break
          default:
            return
        }
        event.preventDefault()
        activate(next, true)
      })
    })
    activate(0)
    preview.dataset.enhanced = ''
    tablist.hidden = false
  }
</script>

<style>
  :global(main:has(.landing)) {
    padding-bottom: 0;
  }
  :global(.content-panel:has(+ .content-panel .landing)) {
    display: none;
  }
  :global(.content-panel:has(.landing)) {
    padding: 0;
    border-top: 0;
  }
  :global(.content-panel:has(.landing) > .sl-container) {
    max-width: none;
  }
  :global(.content-panel:has(.landing) > .sl-container > footer) {
    display: none;
  }

  .landing {
    --landing-gutter: 1.5rem;
    --landing-line: var(--sl-color-gray-5);
    --landing-muted: var(--sl-color-gray-3);
    --landing-surface: var(--sl-color-gray-6);
    --landing-ease: cubic-bezier(0.22, 1, 0.36, 1);
    color: var(--sl-color-white);
    line-height: 1.5;
  }
  :global([data-theme='light']) .landing {
    --landing-surface: var(--sl-color-black);
  }
  .wrap {
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: var(--landing-gutter);
  }
  .landing :is(h1, h2, h3) {
    margin: 0;
    text-wrap: balance;
  }
  .landing p {
    margin: 0;
    text-wrap: pretty;
  }
  .landing :is(ul, ol) {
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .landing figure {
    margin: 0;
    min-width: 0;
  }
  .landing a {
    text-decoration: none;
  }
  .landing code {
    font-family: var(--sl-font-mono);
  }
  .landing p code {
    font-size: 0.875em;
    overflow-wrap: anywhere;
    color: var(--sl-color-white);
  }
  .landing [hidden] {
    display: none !important;
  }
  .landing :is(section[id], h2[id]) {
    scroll-margin-top: calc(var(--sl-nav-height) + 1.5rem);
  }

  .heading-1 {
    font-size: 2.25rem;
    line-height: 2.5rem;
    font-weight: 600;
    letter-spacing: -0.04em;
  }
  .heading-2 {
    font-size: 1.875rem;
    line-height: 2.25rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .heading-5 {
    font-size: 1.25rem;
    line-height: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .title-2 {
    font-size: 1.125rem;
    line-height: 1.75rem;
    font-weight: 500;
  }
  .title-3 {
    font-size: 1rem;
    line-height: 1.5rem;
    font-weight: 500;
  }
  .body-lead {
    font-size: 1.125rem;
    line-height: 1.75rem;
    font-weight: 400;
  }
  .body-3 {
    font-size: 1rem;
    line-height: 1.5rem;
    font-weight: 400;
  }
  .button-md {
    font-size: 1rem;
    line-height: 1.5rem;
    font-weight: 600;
  }
  .button-sm {
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 600;
  }
  .caption-1 {
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
  }
  .caption-2 {
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 400;
  }
  .muted {
    color: var(--landing-muted);
  }
  .eyebrow {
    color: var(--sl-color-text-accent);
  }

  .btn,
  .text-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3rem;
  }
  .btn {
    padding: 0.5rem 0.75rem;
    border: 1px solid transparent;
    border-radius: 0.5rem;
    text-align: center;
  }
  .btn,
  .text-link,
  .preview-tab {
    transition:
      color 300ms var(--landing-ease),
      background-color 300ms var(--landing-ease),
      transform 300ms var(--landing-ease);
  }
  .btn:active,
  .preview-tab:active {
    transform: scale(0.98);
  }
  .btn :global(svg),
  .text-link :global(svg) {
    flex: none;
  }
  .primary {
    background: var(--sl-color-text-accent);
    color: var(--sl-color-text-invert);
  }
  .primary:hover {
    background: var(--azu-accent-hover);
  }
  /* "Try the demo", beside "Get started" (commented out until the demo is live) */
  .secondary {
    border-color: var(--sl-color-gray-5);
    color: var(--sl-color-white);
  }
  .secondary:hover {
    border-color: var(--sl-color-text-accent);
    color: var(--sl-color-text-accent);
  }
  .text-link {
    justify-content: flex-start;
    color: var(--sl-color-white);
    text-underline-offset: 0.25em;
  }
  .text-link:hover {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding-top: 2.5rem;
    padding-bottom: 2.5rem;
    text-align: center;
  }
  .hero h1#_top {
    max-width: 42.5rem;
    letter-spacing: -0.04em;
  }
  .hero-lead {
    max-width: 36rem;
    color: var(--landing-muted);
  }
  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: var(--landing-muted);
  }
  .hero-requirements {
    max-width: 36rem;
    color: var(--landing-muted);
  }
  .hero-compatibility {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0 1rem;
    max-width: 42.5rem;
  }
  .hero-limits {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    color: var(--sl-color-text-accent);
    text-decoration: underline !important;
    text-underline-offset: 0.25em;
  }
  .hero-limits:hover {
    color: var(--azu-accent-hover);
  }
  .preview-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--sl-color-text-accent);
  }

  .showcase {
    scroll-margin-top: calc(var(--sl-nav-height) + 1.5rem);
  }
  .showcase-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
