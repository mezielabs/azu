---
/**
 * The landing page at "/", design "A · Product first". index.mdx uses
 * Starlight's splash template without a hero, so this component renders
 * everything under the header, the h1 included (PageTitle.astro skips this
 * page). See docs/decisions.md, "The landing page owns its layout".
 */
import { Image } from 'astro:assets'
import { Code, Icon } from '@astrojs/starlight/components'
import {
  ArrowRight,
  Check,
  Copy,
  Database,
  HardDrive,
  Layers,
  LayoutDashboard,
  Link as LinkIcon,
  ListChecks,
  Palette,
  ShieldCheck,
  Table,
  Zap,
} from '@lucide/astro'
import DemoCode from './DemoCode.astro'
import lockup from '../assets/brand/azu-lockup.svg'
import lockupReversed from '../assets/brand/azu-lockup-reversed.svg'
import formCardDark from '../../../../docs/screenshots/form-card-dark.png'
import formCardLight from '../../../../docs/screenshots/form-card-light.png'
import listDark from '../../../../docs/screenshots/list-dark.png'
import listLight from '../../../../docs/screenshots/list-light.png'
import listPhoneDark from '../../../../docs/screenshots/list-phone-dark.png'
import listPhoneLight from '../../../../docs/screenshots/list-phone-light.png'

const github = 'https://github.com/mezielabs/azu'
const discussions = `${github}/discussions`

const installCommand = 'npm i @mezielabs/azu@preview @mezielabs/azu-react@preview'

const terminal = `# 1. Bouncer
node ace add @adonisjs/bouncer

# 2. Azu, from the preview tag
${installCommand}
node ace configure @mezielabs/azu

# 3. Allow your account in app/abilities/main.ts, then:
node ace migration:run
node ace azu:resource User --policy
npm run dev`

const listAlt =
  "Azu's product list in the demo store: search, filters, thumbnails, prices, status badges, and stock levels"
const listPhoneAlt = "Azu's product list on a phone: products as cards, with search, sort, and selection"
const formAlt =
  "The demo's product edit form in sections: name, SKU, price in naira, a category select, tags, status, a description editor, and a thumbnail"

const rules = [
  {
    icon: Database,
    title: 'Lucid models',
    text: 'Lists, detail pages, and forms come from your models and their relationships. Relations in columns are preloaded, so there are no N+1 queries.',
  },
  {
    icon: ShieldCheck,
    title: 'Bouncer policies',
    text: 'Every page and action is checked on the server, including each record in a bulk action. A missing policy method means denied.',
  },
  {
    icon: ListChecks,
    title: 'VineJS validators',
    text: 'Forms save through your validators, and their messages show on the field. Only declared fields ever reach them.',
  },
  {
    icon: HardDrive,
    title: 'Drive disks',
    text: "Images and files go to the disks you configured. The server checks each upload's size and type.",
  },
]

const features = [
  {
    icon: Table,
    title: 'Lists that hold up',
    text: 'Search, sort, filters, and column choice that stays in the URL. On phones, rows become cards.',
  },
  {
    icon: Zap,
    title: 'Row and bulk actions',
    text: 'Run an action on one record or many. Each record passes its policy, and the work runs in a transaction.',
  },
  {
    icon: LinkIcon,
    title: 'Relationships',
    text: 'belongsTo selects, hasMany lists, and manyToMany pickers you can search, synced on save.',
  },
  {
    icon: LayoutDashboard,
    title: 'Screens and widgets',
    text: 'Add dashboards, settings forms, and reports. Value, progress, partition, table, and trend metrics are built in.',
  },
  {
    icon: Palette,
    title: 'Your brand, light and dark',
    text: 'Set one brand colour. Azu adjusts it so every text pair stays at WCAG AA in both themes.',
  },
  {
    icon: Layers,
    title: 'Override anything',
    text: 'Swap a field or page for your own React component, or publish a page and own it. No fork.',
  },
]

const steps = [
  { title: 'Add Bouncer', text: "The panel's access gate is a Bouncer ability." },
  {
    title: 'Install and configure Azu',
    text: 'Configure checks your setup first. Then it adds the config, the admin entry, and an access ability.',
  },
  {
    title: 'Let yourself in',
    text: 'Allow your account in accessAdmin, generate a resource, and open /admin.',
  },
]

// The Installation page's requirements, worded the same
const requirements = [
  'AdonisJS 7 with Lucid, Auth, and Bouncer',
  'Inertia with React',
  'Node.js 24.21 or later',
  'PostgreSQL, MySQL, or SQLite',
]

const footerLinks = [
  { label: 'Docs', href: '/docs/' },
  { label: 'Changelog', href: '/docs/changelog/' },
  { label: 'Roadmap', href: '/docs/roadmap/' },
  { label: 'Discussions', href: discussions },
  { label: 'GitHub', href: github },
]
---

<div class="landing not-content">
  <section class="wrap hero" aria-labelledby="_top">
    <p class="pill"><span class="dot" aria-hidden="true"></span>In preview, for AdonisJS 7 with Inertia and React</p>
    <h1 id="_top">The back of your AdonisJS app.</h1>
    <p class="hero-lead">
      Azu is an admin panel for AdonisJS 7. Build searchable lists, detail pages, and forms from the
      Lucid models, Bouncer policies, and VineJS validators you already have.
    </p>
    <div class="hero-actions">
      <a class="btn primary" href="/docs/installation/">
        Get started
        <ArrowRight size={18} />
      </a>
      <div class="install-command">
        <code><span class="prompt" aria-hidden="true">$ </span>{installCommand}</code>
        <button type="button" class="copy-button" aria-label="Copy the install command" data-copy={installCommand}>
          <Copy class="copy-idle" size={18} stroke-width={1.75} />
          <Check class="copy-done" size={18} />
        </button>
        <span class="sr-only" role="status" data-copy-status></span>
      </div>
    </div>
  </section>

  {/*
    Four images, theme × width, rather than <picture><source media>: Astro's
    Picture only writes format sources, and one <img> can't carry both alts.
    Each is hidden by Starlight's theme class or a width query (below), and
    a lazy hidden image never loads, so only the visible one is fetched.
  */}
  <figure class="wrap shot">
    <div class="browser">
      <div class="browser-bar">
        <span class="browser-dots" aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="browser-url">localhost:3333/admin/resources/products</span>
      </div>
      <Image
        src={listLight}
        alt={listAlt}
        class="dark:sl-hidden shot-desktop"
        data-shot="light-desktop"
        loading="lazy"
        widths={[640, 1280, 1920, 2560]}
        sizes="(min-width: 75rem) 71rem, calc(100vw - 2.5rem)"
      />
      <Image
        src={listDark}
        alt={listAlt}
        class="light:sl-hidden shot-desktop"
        data-shot="dark-desktop"
        loading="lazy"
        widths={[640, 1280, 1920, 2560]}
        sizes="(min-width: 75rem) 71rem, calc(100vw - 2.5rem)"
      />
      <Image
        src={listPhoneLight}
        alt={listPhoneAlt}
        class="dark:sl-hidden shot-phone"
        data-shot="light-phone"
        loading="lazy"
        widths={[300, 600]}
        sizes="min(18.75rem, calc(100vw - 2.5rem))"
      />
      <Image
        src={listPhoneDark}
        alt={listPhoneAlt}
        class="light:sl-hidden shot-phone"
        data-shot="dark-phone"
        loading="lazy"
        widths={[300, 600]}
        sizes="min(18.75rem, calc(100vw - 2.5rem))"
      />
    </div>
    <figcaption>The demo store's products, from one resource file and the app's own policy.</figcaption>
  </figure>
  {/*
    Starlight sets data-theme in the head, so the theme is known here, and
    so is the width: load the shot for both now. The others stay lazy, and a
    hidden lazy image only loads if the theme or width changes.
  */}
  <script is:inline>
    document
      .querySelectorAll(
        'img[data-shot="' +
          document.documentElement.dataset.theme +
          (matchMedia('(max-width: 39.9375rem)').matches ? '-phone' : '-desktop') +
          '"]'
      )
      .forEach(function (img) {
        img.loading = 'eager'
        img.fetchPriority = 'high'
      })
  </script>

  <section class="wrap section" aria-labelledby="rules-title">
    <div class="intro">
      <p class="eyebrow">One source of truth</p>
      <h2 id="rules-title">One set of rules, and it's yours.</h2>
      <p>
        Azu doesn't keep its own permissions or validation. It calls the code your app already runs, so
        the panel can't drift from it.
      </p>
    </div>
    <ul class="rules" role="list">
      {
        rules.map(({ icon: RuleIcon, title, text }) => (
          <li class="rule">
            <span class="rule-icon" aria-hidden="true">
              <RuleIcon size={20} stroke-width={1.75} />
            </span>
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap section" aria-labelledby="write-title">
    <div class="intro">
      <p class="eyebrow">What you write</p>
      <h2 id="write-title">One small file per resource.</h2>
      <p>
        Point it at a model, then borrow the policy and validators you already wrote. This is the demo
        store's categories.
      </p>
    </div>
    <div class="write">
      <div>
        <DemoCode file="app/admin/resources/category_resource.ts" />
        <p class="note">
          Typed against the model, so a typo like <code>column.text('nmae')</code> fails <code>tsc</code>.
        </p>
      </div>
      <figure class="form-shot">
        <div class="frame">
          <Image
            src={formCardLight}
            alt={formAlt}
            class="dark:sl-hidden"
            loading="lazy"
            widths={[480, 960, 1520]}
            sizes="(min-width: 75rem) 28rem, (min-width: 64rem) calc(40vw - 2rem), calc(100vw - 2.5rem)"
          />
          <Image
            src={formCardDark}
            alt={formAlt}
            class="light:sl-hidden"
            loading="lazy"
            widths={[480, 960, 1520]}
            sizes="(min-width: 75rem) 28rem, (min-width: 64rem) calc(40vw - 2rem), calc(100vw - 2.5rem)"
          />
        </div>
        <figcaption>
          The fields become the create and edit forms, checked by your validators. Here's the demo's
          product form, with sections and a tag picker.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="band" aria-labelledby="box-title">
    <div class="wrap band-inner">
      <div class="intro">
        <p class="eyebrow">In the box</p>
        <h2 id="box-title">Everything a back office needs.</h2>
        <p>
          Lists, forms, and actions come from the resource. Screens cover the pages that aren't about
          one model.
        </p>
      </div>
      <ul class="features" role="list">
        {
          features.map(({ icon: FeatureIcon, title, text }) => (
            <li class="feature">
              <span class="feature-icon" aria-hidden="true">
                <FeatureIcon size={22} stroke-width={1.75} />
              </span>
              <div>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="install-title">
    <div class="install">
      <div class="intro">
        <p class="eyebrow">Install</p>
        <h2 id="install-title">From a fresh app to /admin in about two minutes.</h2>
        <p>Timed on a new React starter kit, from adding Bouncer to editing a user.</p>
        <ol class="steps" role="list">
          {
            steps.map(({ title, text }, index) => (
              <li class="step">
                <span class="step-number" aria-hidden="true">
                  {index + 1}
                </span>
                <div>
                  <h3>{title}</h3>
                  <p>{text}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <div>
          <a class="btn secondary" href="/docs/installation/">
            Read the installation guide
            <ArrowRight size={16} />
          </a>
        </div>
      </div>
      <Code code={terminal} lang="sh" title="Terminal" />
    </div>
  </section>

  <section class="wrap open-source-wrap" aria-labelledby="open-source-title">
    <div class="open-source">
      <div class="open-source-copy">
        <h2 id="open-source-title">Free, open source, and in preview.</h2>
        <p>
          Azu is MIT licensed. The API may still change, so tell us what you'd change before it
          settles.
        </p>
        <a class="limits-link" href="/docs/preview-limits/">See what's not ready yet</a>
        <div class="open-source-actions">
          <a class="btn on-ink-primary" href={discussions}>Join the discussion</a>
          <a class="btn on-ink-secondary" href={github}>
            <Icon name="github" size="1.125rem" />
            View on GitHub
          </a>
        </div>
      </div>
      <div class="needs">
        <h3>What you need</h3>
        <ul role="list">
          {
            requirements.map((requirement) => (
              <li>
                <span aria-hidden="true">·</span>
                {requirement}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <footer class="site-footer">
    <div class="wrap site-footer-inner">
      <div class="site-footer-brand">
        <Image src={lockup} alt="Azu" class="dark:sl-hidden" />
        <Image src={lockupReversed} alt="Azu" class="light:sl-hidden" />
        <p>Built by Mezie Labs. MIT licence.</p>
      </div>
      <nav aria-label="Footer">
        {footerLinks.map(({ label, href }) => <a href={href}>{label}</a>)}
      </nav>
    </div>
  </footer>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const status = button.parentElement?.querySelector('[data-copy-status]')
    let timer: number | undefined

    button.addEventListener('click', async () => {
      window.clearTimeout(timer)
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '')
      } catch {
        // Select the command (after the $ prompt), so it's ready to copy by hand
        const code = button.parentElement?.querySelector('code')
        const selection = window.getSelection()
        if (code && selection) {
          const range = document.createRange()
          range.selectNodeContents(code)
          const prompt = code.querySelector('.prompt')
          if (prompt) range.setStartAfter(prompt)
          selection.removeAllRanges()
          selection.addRange(range)
        }
        if (status) status.textContent = "Couldn't copy, so the command is selected for you."
        return
      }
      button.dataset.copied = ''
      if (status) status.textContent = 'Copied'
      timer = window.setTimeout(() => {
        delete button.dataset.copied
        if (status) status.textContent = ''
      }, 2000)
    })
  }
</script>

<style>
  /*
   * Landing.astro owns this page (docs/decisions.md). PageTitle renders
   * nothing here, so its panel is empty: drop it. The content panel gives
   * up its padding and 67.5rem width, so each section sets its own and the
   * band can run full width without a 100vw breakout (which scrolls
   * sideways where scrollbars take space). Starlight's footer is empty on
   * this page, and the landing has its own.
   */
  :global(main:has(.landing)) {
    padding-bottom: 0;
  }

  :global(.content-panel:has(+ .content-panel .landing)) {
    display: none;
  }

  :global(.content-panel:has(.landing)) {
    padding: 0;
    border-top: 0;
  }

  :global(.content-panel:has(.landing) > .sl-container) {
    max-width: none;
  }

  :global(.content-panel:has(.landing) > .sl-container > footer) {
    display: none;
  }

  /* Colours: brand.css tokens only. Dark is Starlight's default. */
  .landing {
    --landing-gutter: clamp(1.25rem, 4vw, 2rem);
    --landing-surface: var(--sl-color-gray-6);
    --landing-sunken: var(--sl-color-gray-6);
    --landing-line: var(--sl-color-gray-5);
    --landing-control: var(--sl-color-gray-4);
    --landing-muted: var(--sl-color-gray-3);
    --landing-shadow:
      0 4px 12px color-mix(in srgb, var(--sl-color-hairline-shade) 50%, transparent),
      0 32px 64px -16px color-mix(in srgb, var(--sl-color-hairline-shade) 70%, transparent);
    --landing-band-bg: var(--sl-color-gray-6);
    --landing-band-line: var(--sl-color-gray-5);

    color: var(--sl-color-white);
    line-height: 1.5;
  }

  :global([data-theme='light']) .landing {
    --landing-surface: var(--sl-color-black);
    --landing-sunken: var(--sl-color-gray-7);
    --landing-shadow:
      0 4px 12px color-mix(in srgb, var(--azu-ink) 8%, transparent),
      0 32px 64px -16px color-mix(in srgb, var(--azu-ink) 20%, transparent);
    --landing-band-bg: var(--azu-ink);
    --landing-band-line: var(--azu-ink);
  }

  .wrap {
    max-width: 75rem;
    margin-inline: auto;
    padding-inline: var(--landing-gutter);
  }

  .landing a {
    text-decoration: none;
  }

  .landing code {
    font-family: var(--sl-font-mono);
  }

  .landing :is(h1, h2, h3) {
    text-wrap: balance;
  }

  .landing p {
    text-wrap: pretty;
  }

  .landing p code {
    font-size: 0.875em;
    color: var(--sl-color-white);
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 3rem;
    padding: 0.5rem 1.25rem;
    border: 1px solid transparent;
    border-radius: 0.625rem;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .btn.primary {
    min-height: 3.125rem;
    padding-inline: 1.5rem;
    font-size: var(--sl-text-base);
    background: var(--sl-color-text-accent);
    color: var(--sl-color-text-invert);
  }

  .btn.primary:hover {
    background: var(--azu-accent-hover);
  }

  .btn.secondary {
    border-color: var(--landing-control);
    background: var(--landing-surface);
    color: var(--sl-color-white);
  }

  .btn.secondary:hover {
    border-color: var(--sl-color-white);
  }

  /* Hero */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    text-align: center;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-size: var(--sl-text-sm);
    font-weight: 500;
  }

  .dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background: currentColor;
  }

  /* The id matches brand.css's h1#_top, so this wins over its letter-spacing */
  .hero h1#_top {
    max-width: 57.5rem;
    font-size: clamp(2.75rem, 6.2vw, 5.25rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--sl-color-white);
  }

  .hero-lead {
    max-width: 42.5rem;
    font-size: clamp(1.125rem, 1.6vw, 1.3125rem);
    line-height: 1.55;
    color: var(--landing-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    max-width: 100%;
    margin-top: 0.5rem;
  }

  .install-command {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    min-width: 0;
    max-width: 100%;
    padding: 0.25rem 0.25rem 0.25rem 1rem;
    border: 1px solid var(--landing-line);
    border-radius: 0.625rem;
    background: var(--landing-surface);
  }

  .install-command code {
    min-width: 0;
    font-size: var(--sl-text-sm);
    text-align: start;
    overflow-wrap: anywhere;
    color: var(--sl-color-white);
  }

  .prompt {
    color: var(--sl-color-text-accent);
  }

  .copy-button {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 0.5rem;
    background: transparent;
    color: var(--landing-muted);
    cursor: pointer;
  }

  .copy-button:hover {
    color: var(--sl-color-white);
  }

  /* The icons are Lucide's components, outside this component's scope */
  .copy-button :global(.copy-done),
  .copy-button[data-copied] :global(.copy-idle) {
    display: none;
  }

  .copy-button[data-copied] :global(.copy-done) {
    display: block;
  }

  /* Product shot */
  .shot {
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .browser {
    overflow: hidden;
    border: 1px solid var(--landing-line);
    border-radius: 0.875rem;
    background: var(--landing-surface);
    box-shadow: var(--landing-shadow);
  }

  .browser-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--landing-line);
    background: var(--landing-sunken);
  }

  .browser-dots {
    display: flex;
    flex: none;
    gap: 0.5rem;
  }

  .browser-dots span {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 999px;
    background: var(--landing-control);
  }

  .browser-url {
    min-width: 0;
    overflow: hidden;
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--landing-muted);
  }

  /* Phone shot below 40rem, desktop shot above. These rules only hide: a
     `display` that shows would beat Starlight's layered sl-hidden. Below
     40rem the frame is a plain rounded screenshot, since a URL bar over a
     phone layout reads wrong. */
  @media (max-width: 39.9375rem) {
    .shot :global(.shot-desktop),
    .browser-bar {
      display: none;
    }

    /* Narrower than the phone itself, so it reads as a picture */
    .browser {
      max-width: 18.75rem;
      margin-inline: auto;
    }
  }

  @media (min-width: 40rem) {
    .shot :global(.shot-phone) {
      display: none;
    }
  }

  /* No `display` here: it would beat Starlight's layered sl-hidden and
     show both themes' images. vertical-align drops the inline gap instead. */
  .landing figure :global(img) {
    width: 100%;
    height: auto;
    vertical-align: top;
  }

  .landing figcaption {
    font-size: var(--sl-text-sm);
    color: var(--landing-muted);
  }

  .shot figcaption {
    margin-top: 1rem;
    text-align: center;
  }

  /* Sections */
  .section {
    padding-top: clamp(5rem, 9vw, 7.5rem);
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 45rem;
  }

  .intro > p:not(.eyebrow) {
    font-size: var(--sl-text-lg);
    line-height: 1.6;
    color: var(--landing-muted);
  }

  .eyebrow {
    font-size: var(--sl-text-sm);
    font-weight: 600;
